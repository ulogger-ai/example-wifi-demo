define:
- name: SL_SI91X_PRINT_DBG_LOG
- name: SLI_SI91X_MCU_MOV_ROM_API_TO_FLASH
requires:
- name: device_needs_ram_execution
configuration:
- name: SL_BOARD_ENABLE_VCOM
  value: '1'
- name: SL_ENABLE_GPIO_WAKEUP_SOURCE
  value: '1'
- name: ENABLE_NPSS_GPIO_2
  value: '1'
- name: SL_ENABLE_CALENDAR_WAKEUP_SOURCE
  value: '1'
- name: ENABLE_ALARM
  value: '1'
- name: ALARM_TIME_MSEC
  value: '30000'
- name: SL_SI91X_WRAP_KEY_BUFFER_SIZE
  value: '1696'
ui_hints:
  highlight:
  - path: readme.md
    focus: true
sdk_extension:
- vendor: silabs
  id: wiseconnect3_sdk
  version: 4.1.1
post_build:
- path: example-wifi-demo.slpb

